# ==================================
# API MONITOR PLATFORM - ENVIRONMENT VARIABLES
# ==================================

# Environment
ENVIRONMENT=development
DEBUG=true

# ==================================
# DATABASE
# ==================================
DATABASE_URL=postgresql+asyncpg://apimonitor:securepassword123@postgres:5432/apimonitor
DATABASE_URL_SYNC=postgresql://apimonitor:securepassword123@postgres:5432/apimonitor

# PostgreSQL Direct Connection
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=apimonitor
POSTGRES_PASSWORD=securepassword123
POSTGRES_DB=apimonitor

# ==================================
# REDIS
# ==================================
REDIS_URL=redis://:redispassword123@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispassword123

# ==================================
# SECURITY
# ==================================
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing
BCRYPT_ROUNDS=12

# ==================================
# BACKEND API
# ==================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
API_V1_PREFIX=/api/v1

# ==================================
# FRONTEND
# ==================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=API Monitor

# ==================================
# CELERY
# ==================================
CELERY_BROKER_URL=redis://:redispassword123@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redispassword123@redis:6379/0
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=300

# ==================================
# EMAIL (SMTP)
# ==================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@apimonitor.com
SMTP_FROM_NAME=API Monitor
SMTP_TLS=true
SMTP_SSL=false

# ==================================
# STRIPE (Billing)
# ==================================
STRIPE_API_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs
STRIPE_PRICE_STARTER=price_starter_monthly
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_BUSINESS=price_business_monthly

# ==================================
# THIRD-PARTY INTEGRATIONS
# ==================================

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# PagerDuty
PAGERDUTY_API_KEY=your_pagerduty_api_key

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==================================
# MONITORING & OBSERVABILITY
# ==================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==================================
# RATE LIMITING
# ==================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FREE_TIER_RPM=60
RATE_LIMIT_STARTER_TIER_RPM=120
RATE_LIMIT_PRO_TIER_RPM=300

# ==================================
# MONITORING DEFAULTS
# ==================================
DEFAULT_CHECK_INTERVAL=300
DEFAULT_TIMEOUT=30
DEFAULT_RETRY_COUNT=2
MAX_CONCURRENT_CHECKS=100

# Monitoring Regions
MONITORING_REGIONS=["us-east-1","us-west-1","eu-west-1","ap-southeast-1"]

# ==================================
# FILE STORAGE
# ==================================
UPLOAD_DIR=/tmp/uploads
MAX_UPLOAD_SIZE=10485760

# S3 (Optional - for file storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=api-monitor-assets
AWS_REGION=us-east-1

# ==================================
# FEATURES FLAGS
# ==================================
FEATURE_3D_VISUALIZATIONS=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_SSL_MONITORING=true
FEATURE_MULTI_REGION=true
FEATURE_WEBSOCKET_MONITORING=true

# ==================================
# LIMITS (Per Workspace Plan)
# ==================================

# Free Tier
FREE_MAX_MONITORS=10
FREE_MAX_TEAM_MEMBERS=1
FREE_CHECK_INTERVAL_MIN=300
FREE_DATA_RETENTION_DAYS=30

# Starter Tier
STARTER_MAX_MONITORS=50
STARTER_MAX_TEAM_MEMBERS=5
STARTER_CHECK_INTERVAL_MIN=60
STARTER_DATA_RETENTION_DAYS=90

# Pro Tier
PRO_MAX_MONITORS=200
PRO_MAX_TEAM_MEMBERS=15
PRO_CHECK_INTERVAL_MIN=30
PRO_DATA_RETENTION_DAYS=365

# Business Tier
BUSINESS_MAX_MONITORS=1000
BUSINESS_MAX_TEAM_MEMBERS=50
BUSINESS_CHECK_INTERVAL_MIN=10
BUSINESS_DATA_RETENTION_DAYS=730

# ==================================
# SESSION MANAGEMENT
# ==================================
SESSION_TIMEOUT_MINUTES=60
MAX_SESSIONS_PER_USER_FREE=3
MAX_SESSIONS_PER_USER_PAID=10

# ==================================
# WEBSOCKET
# ==================================
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS_PER_WORKSPACE=100

# ==================================
# TESTING
# ==================================
TESTING=false
TEST_DATABASE_URL=postgresql+asyncpg://apimonitor:testpass@localhost:5432/apimonitor_test
